# Everything is optional. With nothing set, Hereafter runs on the local SQLite event store
# with the LLM off (the "not a wrapper" mode).

# off = no LLM calls anywhere; events render as raw structured data
HEREAFTER_LLM=on
# One LLM key. OpenAI is used if OPENAI_API_KEY is set, otherwise Anthropic.
# Write KEY=value with no space after the equals sign. Real keys go in .env, never in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Elastic Cloud — the life-event store
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# Browserbase — cold-start crawl of the person's own handles and links
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Encrypts personal data at rest. Generated into .env automatically on first start; never commit it.
HEREAFTER_DATA_KEY=

# off = no live research when a scenario is created
HEREAFTER_RESEARCH=on

# The slow 'what could happen' proposal call: model and OpenAI reasoning effort (defaults: the main model, low)
HEREAFTER_LLM_FAST_MODEL=
HEREAFTER_LLM_FAST_EFFORT=low
