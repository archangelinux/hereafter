# Everything is optional. With nothing set, Hereafter runs on the local SQLite event store
# with the LLM off (the "not a wrapper" mode).

# off = no LLM calls anywhere; events render as raw structured data
HEREAFTER_LLM=on
# One LLM key. OpenAI is used if OPENAI_API_KEY is set, otherwise Anthropic.
# Write KEY=value with no space after the equals sign. Real keys go in .env, never in this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Elastic Cloud — the life-event store
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=

# The two semantic indices. Switching embedding model means a new index and a reindex, because
# semantic_text bakes its inference_id into the mapping: backend/scripts/reindex_semantic.py
HEREAFTER_ES_INDEX=hereafter-life-events-v2
HEREAFTER_ES_EVIDENCE_INDEX=hereafter-evidence-v2
# Elastic Inference Service endpoints (hosted on the cluster, no extra key). Empty rerank id
# drops the rerank stage everywhere and falls back to plain RRF.
HEREAFTER_ES_INFERENCE_ID=.jina-embeddings-v5-text-small
HEREAFTER_ES_RERANK_ID=.jina-reranker-v3.5
# Reranker score above which already-researched evidence is reused instead of crawled again.
HEREAFTER_REUSE_THRESHOLD=0.2

# Who chooses the store queries behind "who you are now": elastic = the Agent Builder agent on
# the cluster (backend/scripts/agent_builder_setup.py registers it), llm = the planner in
# llm.py, rules = no model. Measured on the demo log: elastic ~42 s, llm ~9 s.
HEREAFTER_STATE_PLANNER=llm
HEREAFTER_STATE_PLANNER_TIMEOUT=120

# Browserbase — cold-start crawl of the person's own handles and links
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# Stagehand — read LinkedIn profiles on a Browserbase context that is already signed in to LinkedIn (docs/STAGEHAND.md).
# Leave empty to read LinkedIn as before. Needs the Browserbase pair above and OPENAI_API_KEY (Stagehand uses openai/gpt-5.4-mini; override with HEREAFTER_STAGEHAND_MODEL).
HEREAFTER_LINKEDIN_CONTEXT=
# HEREAFTER_STAGEHAND_MODEL=openai/gpt-5.4-mini

# Encrypts personal data at rest. Generated into .env automatically on first start; never commit it.
HEREAFTER_DATA_KEY=

# off = no live research when a scenario is created
HEREAFTER_RESEARCH=on

# The slow 'what could happen' proposal call: model and OpenAI reasoning effort (defaults: the main model, low)
HEREAFTER_LLM_FAST_MODEL=
HEREAFTER_LLM_FAST_EFFORT=low

# on = also run the national life-table background under long paths (friends' weddings, parents, money drift). Off by default.
HEREAFTER_BACKGROUND=off
